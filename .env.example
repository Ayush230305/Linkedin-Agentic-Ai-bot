
# LLM: ASI:One uses an OpenAI-compatible client
LLM_PROVIDER=asi1
ASI1_API_KEY=replace_with_your_key
ASI1_BASE_URL=https://api.asi1.ai/v1
ASI1_MODEL=replace_with_current_supported_model

# LinkedIn OAuth application
LINKEDIN_CLIENT_ID=replace_with_client_id
LINKEDIN_CLIENT_SECRET=replace_with_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_MEMBER_URN=
LINKEDIN_VERSION=replace_with_current_supported_YYYYMM_version

# LinkPilot
LINKPILOT_OWNER_AGENT_ADDRESS=
LINKPILOT_DB=linkpilot.db
MAX_POST_CHARS=2800
